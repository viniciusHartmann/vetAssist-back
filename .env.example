# =============================================================================
# VetAssist Backend — exemplo de configuracao
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# =============================================================================

# --- Aplicacao ---
NODE_ENV=development
PORT=4000

# Origem do frontend autorizada no CORS. Nunca use "*" — o navegador rejeita
# curinga junto com credentials e isso quebra todas as chamadas do front.
CORS_ORIGIN=http://localhost:3000

# Para onde o callback do OAuth redireciona apos o login.
FRONTEND_URL=http://localhost:3000

# --- Banco de dados (Postgres do Supabase) ---
# Conexao direta. Troque [YOUR-PASSWORD] pela senha real APENAS no .env local.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wvasefpzyixvvvqklunw.supabase.co:5432/postgres
DATABASE_SSL=true

# --- Supabase Auth ---
SUPABASE_URL=https://wvasefpzyixvvvqklunw.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Somente no servidor. Jamais exponha ao navegador.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Sessao ---
# Gere com: openssl rand -base64 48
# APP_JWT_SECRET assina o cookie de sessao; COOKIE_SECRET assina o cookie
# temporario de state/PKCE do OAuth. Devem ser segredos diferentes.
APP_JWT_SECRET=<minimo-32-caracteres>
COOKIE_SECRET=<minimo-32-caracteres>
SESSION_TTL_SECONDS=604800

# Deixe vazio em desenvolvimento (localhost).
COOKIE_DOMAIN=

# --- Rate limiting e logs ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
LOG_LEVEL=debug

# =============================================================================
# Opcionais — modulos ainda NAO implementados (visitas/WS, Deepgram, IA).
# Podem ficar vazios; a aplicacao sobe normalmente sem eles.
# =============================================================================
DEEPGRAM_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
MAX_VISIT_DURATION_SECONDS=3600
AUDIO_SAMPLE_RATE=16000
